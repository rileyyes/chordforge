# ChordForge is a single stdlib-Python process (see chordforge/config.py for the source of
# truth). Nothing here is required to run locally -- only relevant for a real deployment.

# Where the SQLite database and recorded/mixed-down audio files live.
CHORDFORGE_DATA_DIR=./data

# Network
CHORDFORGE_HOST=127.0.0.1
PORT=8000

# Set to 1 behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=0
# Set to 1 if running behind a reverse proxy that sets X-Forwarded-For (for accurate client IPs
# in login rate limiting).
TRUST_PROXY=0

# ---- Limits (enforced server-side) ----
MAX_UPLOAD_MB=20
MAX_DURATION_SECONDS=60
MIN_DURATION_SECONDS=2
SESSION_TTL_HOURS=168
MAX_PROJECTS_PER_USER=50
# Thread-pool size for background "Build my song" mixdown jobs.
MIXDOWN_WORKERS=2
